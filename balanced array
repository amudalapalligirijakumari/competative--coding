class Solution:
    def minValueToBalance(self, arr: list[int]) -> int:
        # code here
        n = len(arr)
        mid = n // 2

        left = 0
        right = 0

        for i in range(mid):
            left += arr[i]

        for i in range(mid, n):
            right += arr[i]

        if left > right:
            return left - right
        else:
            return right - left
